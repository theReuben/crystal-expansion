	setflag FLAG_HIDE_ILEX_FOREST_MASTER
	setflag FLAG_HIDE_ILEX_FOREST_APPRENTICE_FARFETCHD
	setflag FLAG_HIDE_ILEX_FOREST_KURT
	setflag FLAG_HIDE_ILEX_FOREST_LASS
	setflag FLAG_HIDE_SLOWPOKE_WELL_B1F_KURT
