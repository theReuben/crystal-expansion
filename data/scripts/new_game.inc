	setflag FLAG_HIDE_RUINS_OF_ALPH_OUTSIDE_SCIENTIST
	setflag FLAG_HIDE_RUINS_OF_ALPH_OUTSIDE_COWARD
	setflag FLAG_HIDE_RUINS_OF_ALPH_OUTSIDE_YOUNGSTERS
